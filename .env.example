# ====================================================================
# ONFICE VIRTUAL OFFICE: Environment Variables Configuration
# Copy this file to .env.local and update with your actual credentials.
# NEVER commit .env.local with real secrets to version control.
# ====================================================================

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# Supabase PostgreSQL & Auth (Optional - Local persistence active by default)
# --------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --------------------------------------------------------------------
# AI Assistant Provider (Optional - Intelligent workspace reasoning active by default)
# --------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# --------------------------------------------------------------------
# Live Audio & Video Presence (Optional - WebRTC LiveKit)
# --------------------------------------------------------------------
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
